{
  "Version": "2019-10-30",
  "StartAction": "SetLogging",
  "Metadata": {
    "entryPointPosition": {
      "x": 40,
      "y": 40
    },
    "ActionMetadata": {
      "SetLogging": {
        "position": {
          "x": 60,
          "y": 120
        }
      },
      "SetRecording": {
        "position": {
          "x": 260,
